# Logs
front-next/logs
front-next/*.log
front-next/npm-debug.log*

# Runtime data
front-next/pids
front-next/*.pid
front-next/*.seed

# Directory for instrumented libs generated by jscoverage/JSCover
front-next/lib-cov

# Coverage directory used by tools like istanbul
front-next/coverage

# nyc test coverage
front-next/.nyc_output

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
front-next/.grunt

# node-waf configuration
front-next/.lock-wscript

# Compiled binary addons (http://nodejs.org/api/addons.html)
front-next/build/Release

# Dependency directories
front-next/node_modules
front-next/.npm-cache
front-next/.next

# Local secrets
.env
.env.*
!.env.example

# Local databases and Python artifacts
data/
**/__pycache__/
*.py[cod]

# Original local recording (the optimized copy lives in docs/assets)
/Grabacion Funcionamiento.mp4

